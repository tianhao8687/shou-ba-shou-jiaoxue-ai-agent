# Host-only dependency and build artifacts must never overwrite container state.
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Local runtime and test artifacts are not image inputs.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage
backend/harbor.db

# Delivery documents and local tooling are outside the runtime images.
docs/
design-system/
scripts/*
!scripts/check-coverage.py
!scripts/verify-kind-agent.py
.git/
.gitignore
README.md
