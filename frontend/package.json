{
  "name": "harbor-agentops-ui",
  "private": true,
  "version": "3.5.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
