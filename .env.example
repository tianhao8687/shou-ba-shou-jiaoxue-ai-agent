# Harbor AgentOps 3.3 local development defaults.
APP_ENV=local
DEMO_MODE=true
DATABASE_URL=sqlite:///./harbor.db
VECTOR_BACKEND=memory

# Reproducible fallback. V3.2 also includes a validated local Qwen3 Embedding sidecar;
# switch to the semantic settings at the bottom after starting it.
EMBEDDING_BACKEND=lexical-feature-baseline
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Portable default: deterministic fixture mode works without local model weights.
# Switch both values in the real-Qwen section of README after starting the gateway.
MODEL_ENABLED=false
MODEL_FIXTURE_MODE=true
MODEL_PROVIDER=local-openvino
MODEL_NAME=OpenVINO/Qwen3-VL-8B-Instruct-int4-ov
MODEL_ENDPOINT=http://127.0.0.1:8091/v1
MODEL_API_KEY=harbor-local-model-token
MODEL_TIMEOUT_SECONDS=180
# Standalone OpenVINO gateway backpressure: one active request plus this bounded queue.
HARBOR_MODEL_MAX_PENDING_REQUESTS=2
HARBOR_MODEL_QUEUE_TIMEOUT_SECONDS=30

# Use inprocess for a one-command developer loop; use remote for the real network boundary.
TOOL_MODE=inprocess
TOOL_SANDBOX_URL=http://127.0.0.1:8092
TOOL_SANDBOX_TOKEN=harbor-local-health-token
# Optional real read-only production telemetry source. Compose wires its own Prometheus.
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TIMEOUT_SECONDS=5
TOOL_TIMEOUT_SECONDS=8
LAB_ORACLE_TOKEN=harbor-local-oracle-token-change-me

# Replace every secret before exposing the service outside localhost.
AUTH_SIGNING_SECRET=harbor-local-auth-signing-secret-change-me
CAPABILITY_SIGNING_SECRET=harbor-local-capability-secret-change-me
DEMO_PASSWORD=harbor-demo-2026
AUTH_TTL_MINUTES=480
CAPABILITY_TTL_SECONDS=90
MEDIUM_RISK_APPROVAL_QUORUM=1
HIGH_RISK_APPROVAL_QUORUM=2
ENFORCE_REQUESTER_SEPARATION=true

# Local mode can embed a worker; Compose runs API and worker as separate services.
EMBEDDED_WORKER=true
WORKER_ID=local-worker-1
WORKER_POLL_SECONDS=0.25
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=8
FRONTEND_ORIGIN=http://localhost:5173

# Optional PostgreSQL + pgvector deployment:
# DATABASE_URL=postgresql://harbor:password@localhost:5432/harbor
# VECTOR_BACKEND=pgvector

# Optional real semantic embedding service (OpenAI-compatible /embeddings):
# EMBEDDING_BACKEND=openai-compatible
# EMBEDDING_ENDPOINT=http://127.0.0.1:8093/v1
# EMBEDDING_MODEL=OpenVINO/Qwen3-Embedding-0.6B-int4-cw-ov
# EMBEDDING_API_KEY=harbor-local-embedding-token
